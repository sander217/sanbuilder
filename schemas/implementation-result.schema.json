{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sander217/sanbuilder/schemas/implementation-result.schema.json",
  "title": "Design Harness Product Implementation Result",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactType",
    "runId",
    "proposalDigest",
    "approvalDigest",
    "repository",
    "baseBranch",
    "baseCommit",
    "workingBranch",
    "isolatedBranch",
    "writeStarted",
    "status",
    "files",
    "commands",
    "commits",
    "summary",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactType": { "const": "implementation-result" },
    "runId": { "type": "string", "minLength": 1 },
    "proposalDigest": { "$ref": "#/$defs/digest" },
    "approvalDigest": { "$ref": "#/$defs/digest" },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "baseBranch": { "type": "string", "minLength": 1 },
    "baseCommit": { "$ref": "#/$defs/gitCommit" },
    "workingBranch": { "type": "string", "pattern": "^codex/[a-z0-9._/-]+$" },
    "isolatedBranch": { "const": true },
    "writeStarted": { "type": "boolean" },
    "status": { "enum": ["succeeded", "partial", "failed"] },
    "files": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["path", "change"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "change": { "enum": ["added", "modified", "deleted", "renamed"] },
          "previousPath": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" }
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sha", "message"],
        "properties": {
          "sha": { "$ref": "#/$defs/gitCommit" },
          "message": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "headCommit": { "$ref": "#/$defs/gitCommit" },
    "summary": { "type": "string", "minLength": 1 },
    "deviations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "succeeded" } },
        "required": ["status"]
      },
      "then": {
        "required": ["headCommit"],
        "properties": {
          "headCommit": { "$ref": "#/$defs/gitCommit" },
          "writeStarted": { "type": "boolean", "const": true },
          "files": { "type": "array", "minItems": 1, "maxItems": 200 },
          "commits": { "type": "array", "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "partial" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "writeStarted": { "type": "boolean", "const": true } }
      }
    },
    {
      "if": {
        "properties": { "writeStarted": { "const": true } },
        "required": ["writeStarted"]
      },
      "then": {
        "properties": { "files": { "type": "array", "minItems": 1, "maxItems": 200 } }
      }
    },
    {
      "if": {
        "properties": { "commits": { "type": "array", "minItems": 1 } },
        "required": ["commits"]
      },
      "then": { "required": ["headCommit"] }
    },
    {
      "if": { "required": ["headCommit"] },
      "then": {
        "properties": { "commits": { "type": "array", "minItems": 1 } }
      }
    },
    {
      "if": {
        "properties": { "writeStarted": { "const": false } },
        "required": ["writeStarted"]
      },
      "then": {
        "properties": {
          "headCommit": false,
          "files": { "type": "array", "maxItems": 0 },
          "commits": { "type": "array", "maxItems": 0 }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "gitCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "command": {
      "type": "object",
      "required": ["command", "status", "exitCode"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed", "skipped"] },
        "exitCode": { "type": "integer" },
        "outputArtifactDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
