{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sander217/sanbuilder/schemas/figma-backup.schema.json",
  "title": "Design Harness Figma Backup Result",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactType",
    "runId",
    "proposalDigest",
    "implementationResultDigest",
    "productPrDigest",
    "backupOnly",
    "authority",
    "status",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactType": { "const": "figma-backup" },
    "runId": { "type": "string", "minLength": 1 },
    "proposalDigest": { "$ref": "#/$defs/digest" },
    "implementationResultDigest": { "$ref": "#/$defs/digest" },
    "productPrDigest": { "$ref": "#/$defs/digest" },
    "backupOnly": { "const": true },
    "authority": { "const": "non-authoritative" },
    "status": { "enum": ["completed", "failed", "skipped"] },
    "figma": {
      "type": "object",
      "required": ["fileKey", "fileUrl", "nodeIds", "source"],
      "properties": {
        "fileKey": { "type": "string", "minLength": 1 },
        "fileUrl": { "type": "string", "format": "uri" },
        "nodeIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "source": { "const": "approved-design-and-production-code" },
        "snapshotDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "reason": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "completed" } },
        "required": ["status"]
      },
      "then": { "properties": { "figma": {} }, "required": ["figma"] }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["failed", "skipped"] } },
        "required": ["status"]
      },
      "then": { "properties": { "reason": {} }, "required": ["reason"] }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
