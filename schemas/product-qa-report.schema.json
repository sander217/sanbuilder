{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sander217/sanbuilder/schemas/product-qa-report.schema.json",
  "title": "Design Harness Product QA Report",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactType",
    "runId",
    "proposalDigest",
    "implementationResultDigest",
    "qaPolicy",
    "target",
    "status",
    "summary",
    "checks",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactType": { "const": "product-qa-report" },
    "runId": { "type": "string", "minLength": 1 },
    "proposalDigest": { "$ref": "#/$defs/digest" },
    "implementationResultDigest": { "$ref": "#/$defs/digest" },
    "qaPolicy": {
      "type": "object",
      "required": ["ref", "digest"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["repository", "baseBranch", "baseCommit", "headCommit"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "baseBranch": { "type": "string", "minLength": 1 },
        "baseCommit": { "$ref": "#/$defs/gitCommit" },
        "headCommit": { "$ref": "#/$defs/gitCommit" },
        "environmentUrl": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "status": { "enum": ["passed", "failed", "review"] },
    "summary": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "artifactDigests": {
      "type": "array",
      "items": { "$ref": "#/$defs/digest" },
      "uniqueItems": true
    },
    "memoryProposals": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/memoryProposal" }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "passed" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "status": { "const": "passed" } },
              "required": ["status"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "gitCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "memoryProposal": {
      "type": "object",
      "required": ["id", "scope", "subject", "statement", "rationale", "sourceDigests", "confidence", "appliesTo", "reviewWhen", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "scope": { "enum": ["brand", "product"] },
        "subject": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "statement": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "sourceDigests": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/digest" },
          "uniqueItems": true
        },
        "confidence": { "enum": ["low", "medium", "high"] },
        "appliesTo": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "reviewWhen": { "type": "string", "minLength": 1 },
        "status": { "const": "proposed" }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": ["id", "policyGateId", "label", "severity", "status", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "policyGateId": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["blocking", "review"] },
        "status": { "enum": ["passed", "failed", "partial", "skipped"] },
        "summary": { "type": "string", "minLength": 1 },
        "evidenceArtifactDigests": {
          "type": "array",
          "items": { "$ref": "#/$defs/digest" },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "severity": { "const": "blocking" } },
            "required": ["severity"]
          },
          "then": {
            "properties": { "status": { "enum": ["passed", "failed"] } }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
