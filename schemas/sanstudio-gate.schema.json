{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sander217/sanbuilder/schemas/sanstudio-gate.schema.json",
  "title": "Pinned SanStudio Gate Artifact",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactType",
    "runId",
    "stage",
    "inputDigests",
    "sanstudioDependency",
    "status",
    "summary",
    "decisions",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactType": { "enum": ["context-lock", "direction-proposal", "production-package"] },
    "runId": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["context-lock", "direction-lock", "production-lock"] },
    "inputDigests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/digest" }
    },
    "sanstudioDependency": {
      "type": "object",
      "required": ["repository", "revision"],
      "properties": {
        "repository": { "const": "sander217/sanstudio" },
        "revision": { "$ref": "#/$defs/gitCommit" }
      },
      "additionalProperties": false
    },
    "status": { "const": "complete" },
    "summary": { "type": "string", "minLength": 1 },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "alternatives": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "stage": { "const": "context-lock" } }, "required": ["stage"] },
      "then": { "properties": { "artifactType": { "const": "context-lock" } } }
    },
    {
      "if": { "properties": { "stage": { "const": "direction-lock" } }, "required": ["stage"] },
      "then": { "properties": { "artifactType": { "const": "direction-proposal" } } }
    },
    {
      "if": { "properties": { "stage": { "const": "production-lock" } }, "required": ["stage"] },
      "then": { "properties": { "artifactType": { "const": "production-package" } } }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
  },
  "additionalProperties": false
}
